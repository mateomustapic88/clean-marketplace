# Public application URL used for Stripe return URLs.
APP_BASE_URL=http://localhost:3000
# Production value:
# APP_BASE_URL=https://clean-marketplace.com

# Required in production. Mock is allowed only outside production.
INFRASTRUCTURE_MODE=mock

# Supabase public values are safe for the client. The service-role key is server-only.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Keep mock mode enabled for local development and automated tests.
BILLING_MODE=mock

# Server-only Stripe values. Never expose secret or webhook keys via NUXT_PUBLIC_*.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OWNER_MONTHLY_PRICE_ID=
STRIPE_OWNER_ANNUAL_PRICE_ID=
STRIPE_CLEANER_MONTHLY_PRICE_ID=
STRIPE_CLEANER_ANNUAL_PRICE_ID=

# Contact-form delivery through Resend. CONTACT_EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=Clean Marketplace <support@clean-marketplace.com>
CONTACT_EMAIL_TO=cleanmarketplace.2026@gmail.com
