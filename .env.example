# Public application URL used for Stripe return URLs.
APP_BASE_URL=http://localhost:3000
# Production example:
# APP_BASE_URL=https://clean-marketplace-ten.vercel.app

# Keep mock mode enabled for local development and automated tests.
BILLING_MODE=mock

# Required for authenticated server billing sessions in Stripe mode.
AUTH_SESSION_SECRET=

# Server-only Stripe values. Never expose secret or webhook keys via NUXT_PUBLIC_*.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OWNER_PRICE_ID=
STRIPE_CLEANER_PRICE_ID=
